JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MINIMUM_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://frontend:5173
CORS_ALLOW_CREDENTIALS=true

# Backend storage paths (relative to backend working directory)
UPLOAD_DIR=data/uploads
CACHE_DIR=data/cache
USERS_DB_PATH=data/users.db

# Frontend runtime API target
VITE_API_URL=http://localhost:8000
